{
  "name": "wagon-bones-phaser",
  "description": "Balatro-inspired d12 dice roguelike on the Oregon Trail (Phaser 4 + SolidJS + Bun).",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mstenq/wagon-bones-phaser.git"
  },
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/mstenq/wagon-bones-phaser/issues"
  },
  "homepage": "https://github.com/mstenq/wagon-bones-phaser#readme",
  "keywords": [
    "phaser",
    "phaser4",
    "solidjs",
    "vite",
    "typescript",
    "roguelike",
    "dice"
  ],
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs --host",
    "build": "vite build --config vite/config.prod.mjs && bsdtar -a -cf dist.zip dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "check": "bun test && bun run format:check",
    "ci": "bun run check && bun run build",
    "compress:backgrounds": "bun scripts/compress_backgrounds.ts"
  },
  "dependencies": {
    "break_eternity.js": "^2.1.3",
    "phaser": "4.0.0",
    "seedrandom": "^3.0.5",
    "solid-js": "1.9.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/seedrandom": "^3.0.8",
    "fallow": "^2.89.0",
    "pngquant-bin": "^9.0.0",
    "prettier": "^3.8.3",
    "terser": "5.39.0",
    "typescript": "5.7.2",
    "vite": "6.3.1",
    "vite-plugin-solid": "2.11.6"
  }
}