{
  "name": "wagon-bones",
  "description": "Balatro-inspired d12 dice roguelike on the Oregon Trail (Phaser 4 + SolidJS + Bun).",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mstenq/wagon-bones.git"
  },
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/mstenq/wagon-bones/issues"
  },
  "homepage": "https://github.com/mstenq/wagon-bones#readme",
  "keywords": [
    "phaser",
    "phaser4",
    "solidjs",
    "vite",
    "typescript",
    "roguelike",
    "dice"
  ],
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "build": "node log.js build & vite build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "test": "bun test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "check": "bun test && bun run format:check",
    "ci": "bun run check && bun run build"
  },
  "dependencies": {
    "break_eternity.js": "^2.1.3",
    "phaser": "4.0.0",
    "seedrandom": "^3.0.5",
    "solid-js": "1.9.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/seedrandom": "^3.0.8",
    "prettier": "^3.8.3",
    "terser": "5.39.0",
    "typescript": "5.7.2",
    "vite": "6.3.1",
    "vite-plugin-solid": "2.11.6"
  }
}
